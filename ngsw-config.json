{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/i18n/*.json",
          "/icons/*.png",
          "/media/*.woff2",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "tcgdex-api",
      "urls": ["https://api.tcgdex.net/v2/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "4s",
        "cacheOpaqueResponses": false
      }
    },
    {
      "name": "tcgdex-images",
      "urls": ["https://assets.tcgdex.net/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 600,
        "maxAge": "30d",
        "cacheOpaqueResponses": false
      }
    }
  ]
}
